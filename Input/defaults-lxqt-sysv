#----------------------------------------------------------------------
# defaults file for build-iso
#
# This file contains almost all of the variables that determine what
# actually gets built.  It has a middle priority in between
# defaults-system which has the lowest priority and defaults-local
# which has the highest
#----------------------------------------------------------------------

DEFAULTDESKTOP="LXQt_sysvinit"
DISTRO_VERSION="${RELEASEVERSION}_$DEFAULTDESKTOP$ALPHABETARCVERSION"

# kernel
# ahs
# K_REVISION="1-liquorix"
# K_TEMPLATE="%V%G-%R-%A"
# K_VERSION="6.12.8"
#UNSIGNED="-unsigned"

THEME="mxlxqt"
ISO_FLAV="mxlxqt-sysv"
ARCH="amd64"

ENABLE_LOCALES="Default"

# DE particular items
X_TERM_EMULATOR="/usr/bin/qterminal"


# Timestamp appended to the ISO file name (and therefore to its .sha256,
# .zsync and .sig). Comment out for the plain MX-<ver>_LXQt_x64.iso name.
# Evaluated once when this file is sourced, so every file of one build agrees.
ISO_TIMESTAMP="$(date +%Y%m%d-%H%M)"
