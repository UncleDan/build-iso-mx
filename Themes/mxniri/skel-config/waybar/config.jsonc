// Waybar configuration for the MX niri flavour.
// Reference: man 5 waybar, man 5 waybar-niri-workspaces
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 6,

    "modules-left": ["custom/launcher", "niri/workspaces", "niri/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "pulseaudio", "network", "battery", "custom/exit"],

    "custom/launcher": {
        "format": "MX",
        "tooltip": false,
        "on-click": "fuzzel"
    },
    "niri/window": {
        "max-length": 60
    },
    "clock": {
        "format": "{:%a %d %b  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>"
    },
    "tray": {
        "spacing": 8
    },
    "pulseaudio": {
        "format": "vol {volume}%",
        "format-muted": "muted",
        "on-click": "pavucontrol"
    },
    "network": {
        "format-wifi": "{essid} {signalStrength}%",
        "format-ethernet": "wired",
        "format-disconnected": "offline",
        "tooltip-format": "{ifname} {ipaddr}",
        "on-click": "nm-connection-editor"
    },
    "battery": {
        "format": "bat {capacity}%",
        "states": { "warning": 25, "critical": 10 }
    },
    "custom/exit": {
        "format": "exit",
        "tooltip": false,
        "on-click": "niri msg action quit"
    }
}
