#!/bin/sh
# niri-mx-session by Daniele Lolli (UncleDan) feat. Claude AI - Release 1.1 - 2026-09-22 11-47-17
#==============================================================================
# niri-mx-session: start niri from a display manager on MX Linux.
#
# MX ships both systemd and sysvinit (init-diversity) systems. Upstream
# niri-session only works when a systemd (or dinit) user manager is running,
# so this wrapper picks the right way to start the session:
#
#   systemd is PID 1  -> niri-session (niri.service, graphical-session.target,
#                        XDG autostart handled by systemd)
#   anything else     -> niri --session inside its own D-Bus session bus
#==============================================================================

if [ -d /run/systemd/system ] && command -v systemctl >/dev/null 2>&1; then
    exec niri-session "$@"
fi

# No user service manager: load the login environment ourselves.
# shellcheck disable=SC1091
[ -r /etc/profile ] && . /etc/profile
# shellcheck disable=SC1091
[ -r "$HOME/.profile" ] && . "$HOME/.profile"

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=niri

if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] && command -v dbus-run-session >/dev/null 2>&1; then
    exec dbus-run-session niri --session "$@"
fi

exec niri --session "$@"
